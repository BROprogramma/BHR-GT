   xmlns:gmlsf="http://www.opengis.net/gmlsf/2.0"
   xmlns:xs="http://www.w3.org/2001/XMLSchema"
   targetNamespace="http://www.broservices.nl/xsd/dsbhrgt/3"
   elementFormDefault="qualified"
   attributeFormDefault="unqualified"
   version="3.0.0">
   <xs:annotation>
      <xs:appinfo source="http://schemas.opengis.net/gmlsfProfile/2.0/gmlsfLevels.xsd">
         <gmlsf:ComplianceLevel>0</gmlsf:ComplianceLevel>
      </xs:appinfo>
   </xs:annotation>
     <xs:import
      namespace="http://www.broservices.nl/xsd/bhrgtcommon/3"
                 schemaLocation="https://schema.broservices.nl/xsd/bhrgtcommon/3/bhrgtcommon.xsd"/>
      <xs:import namespace="http://www.broservices.nl/xsd/brocommon/3"
                 schemaLocation="https://schema.broservices.nl/xsd/brocommon/3/brocommon.xsd"/>
   <xs:import namespace="http://www.opengis.net/gml/3.2"
      schemaLocation="https://schema.broservices.nl/profile/gml/1.0/gml-profile.xsd" />

   <xs:element name="DispatchCharacteristicsRequest"
               type="dsbhrgt:DispatchCharacteristicsRequestType">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het bericht dispatchCharacteristicsRequest is een specialisatie van AbstractDispatchCharacteristicsRequest in de package brocommon, waaraan het een registratieobject afhankelijk element criteria toevoegt.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="DispatchCharacteristicsRequestType">
      <xs:complexContent>
         <xs:extension base="brocom:AbstractDispatchCharacteristicsRequestType">
            <xs:sequence>
               <xs:element minOccurs="1"
                           maxOccurs="1"
                           name="criteria"
                           nillable="false"
                           type="dsbhrgt:BHR_GT_CriteriaSetType">
                  <xs:annotation>
                     <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De afzonderlijke kenmerken waaraan de registratieobjecten moeten voldoen.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="DispatchCharacteristicsRequestPropertyType">
      <xs:sequence minOccurs="0">
         <xs:element ref="dsbhrgt:DispatchCharacteristicsRequest"/>
      </xs:sequence>
      <xs:attributeGroup ref="gml:AssociationAttributeGroup"/>
   </xs:complexType>
   <xs:element name="DispatchCharacteristicsResponse"
               type="dsbhrgt:DispatchCharacteristicsResponseType"
               substitutionGroup="brocom:DispatchResponse">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: TODO</xs:documentation>
      </xs:annotation>
   </xs:element>
